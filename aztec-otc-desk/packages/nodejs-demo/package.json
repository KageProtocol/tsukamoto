    "order:create": "L2_NODE_URL=http://localhost:8080 API_URL=http://localhost:3001 API_HMAC_SECRET=development_secret_key_32_chars_min bun run scripts/create_order.ts",
    "order:fill": "L2_NODE_URL=http://localhost:8080 API_URL=http://localhost:3001 API_HMAC_SECRET=development_secret_key_32_chars_min bun run scripts/buy_order.ts",
    "test:e2e": "bun run scripts/test-e2e.ts"
