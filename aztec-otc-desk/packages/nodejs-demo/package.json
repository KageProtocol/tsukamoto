{
  "name": "@aztec-otc-desk/cli",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
      "@types/bun": "latest",
      "@types/jest": "^29.5.0",
      "@aztec/aztec.js": "^1.2.1",
      "@aztec/accounts": "^1.2.1",
      "@aztec/ethereum": "^1.2.1",
      "@aztec/stdlib": "^1.2.1",
      "@aztec/noir-contracts.js": "^1.2.1",
      "@aztec-otc-desk/contracts": "workspace:*",
      "dotenv": "^16.3.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "balances": "L2_NODE_URL=http://localhost:8080 bun run scripts/print_balances.ts",
