# Aztec OTC Desk - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DEVELOPMENT ENVIRONMENT SETTINGS
# =============================================================================

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# =============================================================================
# AZTEC NETWORK CONFIGURATION
# =============================================================================

# Aztec L2 Node URL (sandbox for development)
L2_NODE_URL=http://localhost:8080

# Aztec PXE URL (Private Execution Environment)
PXE_URL=http://localhost:8081

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL (PostgreSQL for production, SQLite for development)
DATABASE_URL=postgresql://otc_user:otc_password@localhost:5434/otc_desk
# For SQLite (development): DATABASE_URL=sqlite:./orders.sqlite

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis URL for caching and pub/sub
REDIS_URL=redis://localhost:6381

# =============================================================================
# API SECURITY CONFIGURATION
# =============================================================================

# HMAC Secret for API authentication (CHANGE IN PRODUCTION)
API_HMAC_SECRET=dev_hmac_secret_key_change_in_production_minimum_32_chars
OTC_HMAC_SECRET=dev_hmac_secret_key_change_in_production_minimum_32_chars

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# WEB APPLICATION CONFIGURATION
# =============================================================================

# Frontend URL
NEXT_PUBLIC_OTC_API_URL=http://localhost:3001

# Token Addresses (update with deployed contract addresses)
NEXT_PUBLIC_ETH_ADDRESS=0x0e480358d5764487114eb224935edd6a1c9ac543ec8e56a221887d2d0ff332f9
NEXT_PUBLIC_USDC_ADDRESS=0x127693bf58ba150b04732d0f9cfeb085b3effb37ade0221643108ff4e990f838

# Price Feed Configuration
FDAI_API_KEY=your_price_feed_api_key_here
PRICE_FEED_URL=http://localhost:3002

# =============================================================================
# ORDERFLOW SERVICE CONFIGURATION
# =============================================================================

# Service Port
PORT=3001

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_MS=5000

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090

# Grafana Configuration
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_in_production

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Session Configuration
SESSION_SECRET=your_session_secret_minimum_32_characters_long
SESSION_TIMEOUT_MS=900000

# JWT Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=15m

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Docker Configuration
COMPOSE_PROJECT_NAME=aztec-otc-desk
DOCKER_REGISTRY=your_registry_here

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test Environment
TEST_DATABASE_URL=postgresql://otc_user:otc_password@localhost:5432/otc_desk_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# The following variables should be set in production:

# REQUIRED PRODUCTION CHANGES:
# - Generate secure random values for all *_SECRET variables
# - Use production database URLs
# - Configure proper CORS_ORIGINS
# - Set appropriate LOG_LEVEL (info or warn)
# - Configure monitoring endpoints
# - Set up proper SSL/TLS certificates

# Example production overrides:
# NODE_ENV=production
# LOG_LEVEL=info
# DATABASE_URL=postgresql://user:pass@prod-db:5432/otc_desk
# REDIS_URL=redis://prod-redis:6379
# API_HMAC_SECRET=production_hmac_secret_64_chars_minimum
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com